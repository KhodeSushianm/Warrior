<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules for Android 12+ (ARCHITECTURE.md sec.12: "لایه‌ی دوم" — the manual JSON
  Export remains the primary mechanism).

  Two fixes over the Phase-0 version:
   * `domain="rootdir"` is not a valid value. The accepted domains are root, file, database,
     sharedpref, external and their device_* variants, so that rule was inert.
   * DataStore Preferences are NOT SharedPreferences: `preferencesDataStore` writes
     files/datastore/warrior_settings.preferences_pb, which lives in the `file` domain. Without
     the rule below, every user setting (theme, language, calendar, digits) was silently lost on
     restore even though the comment claimed otherwise.

  Specifying any <include> opts out of the default "back up almost everything" behaviour, so a
  blanket <exclude> is unnecessary. getCacheDir()/getCodeCacheDir()/getNoBackupFilesDir() are
  always excluded by the platform.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Room database: warrior.db (+ -wal/-shm/-journal so a restore is not left mid-write). -->
        <include domain="database" path="." />
        <!-- DataStore Preferences (settings). -->
        <include domain="file" path="datastore/" />
        <!-- AppCompat per-app-language storage on API 32 and below. -->
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
