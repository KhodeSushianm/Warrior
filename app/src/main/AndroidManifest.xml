<?xml version="1.0" encoding="utf-8"?>
<!--
  V1 is Local-first and privacy-by-design (ARCHITECTURE.md sec.17):
  NO INTERNET permission is declared on purpose.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".WarriorApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Warrior"
        tools:targetApi="tiramisu">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          AppCompat's per-app-language persistence service (API 32 and below) is contributed
          automatically by the appcompat manifest merger; sec.13 requires per-app language to work
          on every supported API level (minSdk 26), not only on API 33+.
        -->

        <!-- WorkoutTimerService (Foreground Service) is added in Phase 1. -->

    </application>

</manifest>
