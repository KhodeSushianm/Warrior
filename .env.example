DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Server-side GitHub personal access token used for REST API + git push.
# Keep this out of version control.
GITHUB_ACCESS_TOKEN=

# Repository in owner/name format.
GITHUB_REPO=KhodeSushianm/Warrior

# Optional: OAuth app credentials for browser-based "Connect GitHub account".
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: absolute base URL used to build the OAuth redirect URI.
NEXT_PUBLIC_APP_URL=
